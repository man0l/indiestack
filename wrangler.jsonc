{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "indiestack",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "APP_NAME": "indiestack"
  },
  // One cron for the account. Jobs are rows, not extra triggers.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "indiestack",
      "database_id": "25a22597-8164-44fa-825f-2449241d2364",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "indiestack"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
