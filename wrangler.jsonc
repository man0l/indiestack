{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "indiestack",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "invocation_logs": true
    }
  },
  "vars": {
    "APP_NAME": "indiestack"
  },
  // One cron for the account. Jobs are rows, not extra triggers.
  "triggers": {
    "crons": ["* * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "indiestack",
      "database_id": "25a22597-8164-44fa-825f-2449241d2364",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "indiestack"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "7bf1c43db24a441f987e00666b8b56dd",
      "preview_id": "2f9c596c792a48c49d8f49b51a9386d4"
    }
  ],
  "ai": {
    "binding": "AI"
  }
}
